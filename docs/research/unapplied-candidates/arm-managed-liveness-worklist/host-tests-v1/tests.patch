+def test_inline_trigger_liveness_matches_explicit_split_set_oracle(monkeypatch):
+    for name in ("PCC_DIRECT_INDEXED_KERNEL_CAPTURE", "PCC_DIRECT_INDEXED_KERNEL_EMIT",
+                 "PCC_DIRECT_INDEXED_KERNEL_FUSE_USES"):
+        monkeypatch.setenv(name, "1")
+    monkeypatch.setattr(ir, "_DIRECT_INLINE_ERROR_EDGE_CAPTURE_ENABLED", True)
+    module = ir.Module(name="liveness-trigger")
+    module.triple = "arm64-apple-darwin23.6.0"
+    ptr = ir.PointerType(ir.IntType(8))
+    before = ir.Function(module, ir.FunctionType(ir.VoidType(), []), name="before")
+    trigger = ir.Function(module, ir.FunctionType(ir.IntType(1), []), name="trigger")
+    after = ir.Function(module, ir.FunctionType(ir.VoidType(), []), name="after")
+    cleanup_tick = ir.Function(module, ir.FunctionType(ir.VoidType(), []), name="cleanup_tick")
+    function = ir.Function(module, ir.FunctionType(ptr, [ptr, ptr]), name="probe")
+    function.args[0].name = "p"
+    function.args[1].name = "q"
+    entry = function.append_basic_block("entry")
+    cleanup = function.append_basic_block("cleanup")
+    builder = ir.IRBuilder(entry)
+    builder.call(before, [])
+    failed = builder.call(trigger, [], name="failed")
+    assert ir.IRBuilder_try_inline_error_edge(builder, failed, cleanup, 42, 0)
+    builder.call(after, [])
+    builder.ret(function.args[1])
+    builder.position_at_end(cleanup)
+    builder.call(cleanup_tick, [])
+    builder.ret(function.args[0])
+    direct = module.direct_indexed_module()
+    actual_function = next(item for item in direct.functions if item.name == "probe")
+    actual_kernel = get_indexed_function_kernel(actual_function)
+    assert actual_kernel.inline_error_edge_span(0).second == 1
+    assert actual_kernel.inline_error_edge_trigger(0) == 1
+    actual, _visits, _links, _owners = _native_run(actual_function, ("p", "q"), monkeypatch)
+    text = '''target triple = "arm64-apple-darwin23.6.0"
+declare void @before()
+declare i1 @trigger()
+declare void @after()
+declare void @cleanup_tick()
+define ptr @probe(ptr %p, ptr %q) {
+entry:
+  call void @before()
+  %failed = call i1 @trigger()
+  br i1 %failed, label %cleanup, label %normal
+cleanup:
+  call void @cleanup_tick()
+  ret ptr %p
+normal:
+  call void @after()
+  ret ptr %q
+}
+'''
+    expected = _set_oracle(text, ("p", "q"))
+    def by_callee(rows):
+        assert len({row[2] for row in rows}) == len(rows) == 4
+        return {row[2]: frozenset(row[3]) for row in rows}
+    assert by_callee(actual) == by_callee(expected) == {
+        "before": frozenset(("p", "q")),
+        "trigger": frozenset(("p", "q")),
+        "after": frozenset(("q",)),
+        "cleanup_tick": frozenset(("p",)),
+    }
