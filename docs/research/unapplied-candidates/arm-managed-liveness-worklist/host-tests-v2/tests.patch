+def _reachable_blocks(kernel):
+    reachable = set()
+    pending = [0]
+    while pending:
+        block_id = pending.pop()
+        if block_id in reachable:
+            continue
+        assert 0 <= block_id < len(kernel.block_names)
+        reachable.add(block_id)
+        pending.extend(kernel.cfg_successor_id(block_id, index)
+                       for index in range(kernel.cfg_successor_count(block_id)))
+    return reachable
+
+
+def _parse_function(source, *, detached=()):
     function = parse_self_backend_module(source).functions[0]
+    if not detached:
+        return function
+    kernel = get_indexed_function_kernel(function)
+    # The parser removes unreachable blocks before publishing this kernel.
+    # First parse a valid reachable tail, then detach its entry edge without
+    # changing the terminator kind or its condition-use metadata.
+    all_blocks = set(range(len(kernel.block_names)))
+    assert _reachable_blocks(kernel) == all_blocks
+    assert kernel.cfg_successor_count(0) == 2
+    target = kernel.cfg_successor_id(0, 0)
+    tail = kernel.cfg_successor_id(0, 1)
+    assert tail == kernel.block_names.index(detached[0]) and target != tail
+    kernel.terminator_scalars.set_unchecked(4, target)
+    assert kernel.cfg_successor_id(0, 1) == target
+    detached_ids = {kernel.block_names.index(name) for name in detached}
+    assert _reachable_blocks(kernel) == all_blocks - detached_ids
+    return function
+
+
+def _set_oracle(source, names, *, detached=()):
+    function = _parse_function(source, detached=detached)
