+@pytest.mark.parametrize("kind_id", range(len(PARSED_INSTRUCTION_KINDS)))
+@pytest.mark.parametrize("fixed_payload", [False, True])
+def test_indexed_adapter_preserves_selector_arguments_and_unknown_errors(
+    monkeypatch, kind_id, fixed_payload,
+):
+    """All kind spellings retain the same dispatcher, including unknown kinds."""
+    function = SimpleNamespace(name="provider")
+    block = SimpleNamespace(name="entry")
+    operands = ("operand", object())
+    calls = []
+
+    class Kernel:
+        def instruction_data(self, block_id, instruction_index):
+            assert (block_id, instruction_index) == (2, 3)
+            calls.append("decode")
+            return operands
+
+    def memory(function_arg, kind, data):
+        assert function_arg is function and data is operands
+        calls.append(("memory", kind))
+        return None
+
+    def compute(function_arg, kind, data):
+        assert function_arg is function and data is operands
+        calls.append(("compute", kind))
+        return None
+
+    monkeypatch.setattr(emitter, "_emit_memory_instruction", memory)
+    monkeypatch.setattr(emitter, "_emit_compute_instruction", compute)
+    with pytest.raises(BackendUnavailable) as old:
+        emitter._emit_instruction(function, block, ParsedInstr(PARSED_INSTRUCTION_KINDS[kind_id], operands))
+    old_calls = calls[:]
+    calls.clear()
+    with pytest.raises(BackendUnavailable) as new:
+        emitter._emit_indexed_instruction(
+            function, block, Kernel(), 2, 3, 17, kind_id,
+            19 if fixed_payload else operands, True,
+        )
+    assert str(new.value) == str(old.value)
+    assert calls == (["decode"] if fixed_payload else []) + old_calls
+
