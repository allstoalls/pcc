+@pytest.mark.parametrize("target", (TARGET, WINDOWS))
+def test_actual_direct_capture_uses_the_instruction_adapter(tmp_path, monkeypatch, target):
+    from pcc.ir import ir
+
+    monkeypatch.setenv("PCC_DIRECT_INDEXED_KERNEL_CAPTURE", "1")
+    monkeypatch.setenv("PCC_DIRECT_INDEXED_KERNEL_EMIT", "0")
+    monkeypatch.setenv("PCC_DIRECT_INDEXED_KERNEL_FUSE_USES", "1")
+    monkeypatch.setenv("PCC_DIRECT_INDEXED_KERNEL_REQUIRE_ZERO_FALLBACK", "1")
+    source = ir.Module(name="x86-direct-instruction-bridge")
+    source.triple = target
+    i64 = ir.IntType(64)
+    function = ir.Function(source, ir.FunctionType(i64, [i64]), "increment")
+    builder = ir.IRBuilder(function.append_basic_block("entry"))
+    value = builder.add(function.args[0], ir.Constant(i64, 2), name="result")
+    builder.ret(value)
+    text = str(source)
+    direct = source.direct_indexed_module()
+    assert source._direct_indexed_fallback_records == 0
+    assert all(not function.blocks for function in direct.functions)
+    expected = _emit(_legacy_module(tmp_path, text), target, False)
+    actual = _emit(direct, target, False)
+    assert actual == expected
+    assert all(get_indexed_function_kernel(function).instruction_arena_diagnostic_projections == 0
+               for function in direct.functions)
+
+
+def _outcome(tmp_path, source, *, eager):
+    module = None
+    try:
+        module = _indexed_module(tmp_path, source)
+        if eager:
+            for function in module.functions:
+                get_indexed_function_kernel(function).materialize_legacy_blocks(function)
+        _emit(module, module.triple, False)
+    except (BackendUnavailable, IndexError, KeyError, ValueError, TypeError) as error:
+        return type(error), str(error)
+    finally:
+        if module is not None:
+            _close(module)
+    raise AssertionError("malformed/unsupported fixture unexpectedly emitted")
+
+
+@pytest.mark.parametrize("target", (TARGET, WINDOWS))
+@pytest.mark.parametrize("body", (
+    "define i64 @bad() {\nentry:\n ret i64 %missing\n}",
+    "define i64 @bad() {\nentry:\n br label %missing\n}",
+    "define i64 @bad(i32 %value) {\nentry:\n %sum = add i64 %value, 1\n ret i64 %sum\n}",
+    "define i32 @bad(<4 x i32> %vector) {\nentry:\n %lane = extractelement <4 x i32> %vector, i32 0\n ret i32 %lane\n}",
+    "define i1 @bad(ptr %cell) {\nentry:\n %value = load atomic i1, ptr %cell acquire, align 1\n ret i1 %value\n}",
+    "define i32 @bad() {\nentry:\n %value = mystery i32 1\n ret i32 %value\n}",
+))
+def test_single_malformed_or_unsupported_input_keeps_exception(tmp_path, target, body):
+    source = 'target triple = "' + target + '"\n' + body
+    assert _outcome(tmp_path, source, eager=False) == _outcome(tmp_path, source, eager=True)
+
+
+@pytest.mark.parametrize("target", (TARGET, WINDOWS))
+def test_corrupt_flag_side_table_is_rejected_before_instruction_selection(
+    tmp_path, monkeypatch, target,
+):
+    source = 'target triple = "' + target + '"\n' + '''
+define i64 @flagged(i64 %value) {
+entry:
+  %sum = add nsw i64 %value, 1
+  ret i64 %sum
+}
+'''
+    outcomes = []
+    for eager in (True, False):
+        module = _indexed_module(tmp_path, source)
+        function = module.functions[0]
+        kernel = get_indexed_function_kernel(function)
+        assert kernel.instruction_arithmetic_flag_values
+        instruction_id = next(iter(kernel.instruction_arithmetic_flag_values))
+        assert kernel.instruction_metadata.get_unchecked(instruction_id * 4 + 3)
+        del kernel.instruction_arithmetic_flag_values[instruction_id]
+        blocks, block_map = function.blocks, function.block_map
+        try:
+            with monkeypatch.context() as guard:
+                def forbidden(*args, **kwargs):
+                    raise AssertionError("corrupt flag metadata reached a selector")
+                guard.setattr(emitter, "_emit_memory_instruction", forbidden)
+                guard.setattr(emitter, "_emit_compute_instruction", forbidden)
+                with pytest.raises(KeyError) as caught:
+                    if eager:
+                        kernel.materialize_legacy_blocks(function)
+                    else:
+                        emit_indexed_assembly(module)
+                outcomes.append((type(caught.value), str(caught.value)))
+            assert function.blocks is blocks and not blocks
+            assert function.block_map is block_map and not block_map
+            assert not emitter._X86_EMISSION_ACTIVE and not emitter._WINDOWS_ABI
+        finally:
+            _close(module)
+    assert outcomes[0] == outcomes[1]
