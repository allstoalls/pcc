+"""Direct x86 input skips instruction arenas, preserving the tuple selectors.
+
+These are owned host emission/object checks, with no native execution. The
+legacy-block arm remains an independent eager materialization reference.
+Multiply-invalid payload diagnostic precedence is outside this equivalence
+claim: operand decoding is deliberately delayed until selection.
+"""
+
+from types import SimpleNamespace
+
+import pytest
+
+from pcc.backend import BackendUnavailable
+from pcc.backend import coff_x86_64 as coff
+from pcc.backend import elf_x86_64 as elf
+from pcc.backend import self_backend_ir as parsed_ir
+from pcc.backend import self_backend_x86_64_linux as emitter
+from pcc.backend.precise_stackmap import ARCH_X86_64, decode_stack_map
+from pcc.backend.self_backend_ir import PARSED_INSTRUCTION_KINDS, ParsedInstr
+from pcc.backend.self_backend_kernel import (
+    IndexedFunctionKernel,
+    get_indexed_function_kernel,
+)
+from pcc.backend.target_objects import emit_indexed_assembly, encode_assembly_object
+from tests.python.test_precise_stackmap_abi import _target_final_stackmap_ir
+from tests.python.test_x86_64_emission_lifetime import (
+    PROGRAM,
+    TARGET,
+    _indexed_module,
+    _legacy_module,
+)
+from tests.python.x86_64_atomics_ir_gen import build_module as atomic_program
+
+
+WINDOWS = "x86_64-pc-windows-msvc"
+ROUTES = ((TARGET, False), (TARGET, True), (WINDOWS, False))
+SCALAR_PROGRAM = '''
+@table = global [2 x i64] [i64 7, i64 11]
+declare i64 @external(i64)
+declare i64 @variadic(i64, ...)
+define i64 @scalar(i64 %n, ptr %callee) {
+entry:
+  %slot = alloca i64, align 8
+  store volatile i64 %n, ptr %slot, align 8
+  %loaded = load volatile i64, ptr %slot, align 8
+  %sum = add nsw i64 %loaded, 2
+  %cmp = icmp slt i64 %sum, 15
+  %selected = select i1 %cmp, i64 %sum, i64 15
+  %frozen = freeze i64 %selected
+  %address = getelementptr [2 x i64], ptr @table, i64 0, i64 1
+  %element = load i64, ptr %address, align 8
+  %as_int = ptrtoint ptr %address to i64
+  %as_ptr = inttoptr i64 %as_int to ptr
+  %again = load i64, ptr %as_ptr, align 8
+  %first = call i64 @external(i64 %frozen)
+  %second = call i64 %callee(i64 %first)
+  %third = call i64 (i64, ...) @variadic(i64 %second, i64 %element)
+  %result = xor i64 %third, %again
+  ret i64 %result
+}
+'''
+FLOAT_AGGREGATE_PROGRAM = '''
+define double @floating(double %x) {
+entry:
+  %sum = fadd double %x, 1.000000e+00
+  %negative = fneg double %sum
+  %ordered = fcmp olt double %negative, 0.000000e+00
+  %chosen = select i1 %ordered, double %negative, double %x
+  %small = fptrunc double %chosen to float
+  %wide = fpext float %small to double
+  ret double %wide
+}
+define i64 @aggregate(i64 %value) {
+entry:
+  %pair = insertvalue { i64, i64 } zeroinitializer, i64 %value, 1
+  %field = extractvalue { i64, i64 } %pair, 1
+  ret i64 %field
+}
+define <4 x i32> @vector(i32 %value) {
+entry:
+  %lane = insertelement <4 x i32> poison, i32 %value, i64 0
+  %splat = shufflevector <4 x i32> %lane, <4 x i32> poison, <4 x i32> zeroinitializer
+  ret <4 x i32> %splat
+}
+'''
+SWITCH_PROGRAM = '''
+define i64 @switcher(i64 %value) {
+entry:
+  switch i64 %value, label %other [ i64 1, label %one i64 2, label %two ]
+one:
+  br label %merge
+two:
+  br label %merge
+other:
+  br label %merge
+merge:
+  %result = phi i64 [ 10, %one ], [ 20, %two ], [ 30, %other ]
+  ret i64 %result
+}
+define void @never() {
+entry:
+  unreachable
+}
+'''
+
+
+@pytest.fixture(autouse=True)
+def fixed_configuration(monkeypatch):
+    monkeypatch.delenv("PCC_CODE_PROFILE", raising=False)
+    monkeypatch.setenv("PCC_SELF_TARGET_PASSES", "none")
+    monkeypatch.setenv("PCC_SELF_TARGET_PASS_TRANSPORT", "text")
+
+
+def _program(case, target):
+    if case == "phi-calls":
+        return PROGRAM.replace(TARGET, target)
+    if case == "roots":
+        return _target_final_stackmap_ir(target)
+    if case == "atomics":
+        return atomic_program().replace(TARGET, target)
+    body = {
+        "scalar": SCALAR_PROGRAM,
+        "float-aggregate": FLOAT_AGGREGATE_PROGRAM,
+        "switch": SWITCH_PROGRAM,
+    }[case]
+    return 'target triple = "' + target + '"\n' + body
+
+
+def _close(module):
+    for function in module.functions:
+        get_indexed_function_kernel(function).close_native_tables()
+
+
+def _emit(module, target, packed):
+    plans = [] if packed else None
+    try:
+        assembly = emit_indexed_assembly(module, stack_map_plans_out=plans)
+        encoded = encode_assembly_object(assembly, target, stack_map_plans=plans)
+        return assembly, encoded
+    finally:
+        _close(module)
+
+
+def _decoded(data, target):
+    parsed = coff.parse_object(data) if target == WINDOWS else elf.parse_relocatable(data)
+    stackmaps = tuple(
+        decode_stack_map(section.data, expected_arch=ARCH_X86_64)
+        for section in parsed.sections if section.name == ".pcc_stackmaps"
+    )
+    assert stackmaps
+    return parsed, stackmaps
+
+
+@pytest.mark.parametrize("target,packed", ROUTES)
+@pytest.mark.parametrize("case", (
+    "phi-calls", "roots", "atomics", "scalar", "float-aggregate", "switch",
+))
+def test_lazy_instruction_input_matches_eager_assembly_and_complete_object(
+    tmp_path, monkeypatch, target, packed, case,
+):
+    source = _program(case, target)
+    eager = _legacy_module(tmp_path, source)
+    eager_kernels = [get_indexed_function_kernel(function) for function in eager.functions]
+    expected = _emit(eager, target, packed)
+    assert sum(kernel.instruction_arena_diagnostic_projections for kernel in eager_kernels) > 0
+
+    direct = _indexed_module(tmp_path, source)
+    kernels = [get_indexed_function_kernel(function) for function in direct.functions]
+    original_states = [(function.blocks, function.block_map) for function in direct.functions]
+    seen_shells = []
+    emit_blocks = emitter.emit_function_blocks
+
+    def checked_blocks(function, **kwargs):
+        assert kwargs["emit_indexed_instruction"] is emitter._emit_indexed_instruction
+        assert function.blocks and function.block_map
+        assert all(not block.instructions for block in function.blocks)
+        assert all(block.terminator is not None for block in function.blocks)
+        seen_shells.extend(function.blocks)
+        return emit_blocks(function, **kwargs)
+
+    def forbidden(*args, **kwargs):
+        raise AssertionError("direct x86 emission rebuilt a ParsedInstr/operand arena")
+
+    # Install after input construction. The protected scope is real emission,
+    # including preparation and stack-map planning, not codec construction.
+    monkeypatch.setattr(emitter, "emit_function_blocks", checked_blocks)
+    monkeypatch.setattr(IndexedFunctionKernel, "diagnostic_instruction", forbidden)
+    monkeypatch.setattr(parsed_ir, "_interned_operands", forbidden)
+    actual = _emit(direct, target, packed)
+    assert seen_shells
+    assert all(kernel.instruction_arena_diagnostic_projections == 0 for kernel in kernels)
+    for function, (blocks, block_map) in zip(direct.functions, original_states):
+        assert function.blocks is blocks and not blocks
+        assert function.block_map is block_map and not block_map
+    assert actual == expected
+    assert _decoded(actual[1], target) == _decoded(expected[1], target)
+    if target == WINDOWS:
+        names = {section.name for section in coff.parse_object(actual[1]).sections}
+        assert {".pdata", ".xdata"} <= names
+
