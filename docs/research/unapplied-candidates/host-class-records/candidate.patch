+    schema = exports_wire._HOST_NATIVE_EXPORT_RECORD_SCHEMA
+    dependency_map = {} if indexed else None
+
+    def noop(*_args, **_kwargs):
+        return None
+
+    def write_manifest(_manifest, result, _export_dir, _exports, _ast_dir, _sources, _modules, chunk, **kwargs):
+        index = chunk[0]
+        events.append(("manifest", kwargs["job_kind"], tuple(chunk)))
+        rows = []
+        for tail in row_tails[index]:
+            rows.append("EXPORT\t" + modules[index] + ".exports\t" + modules[index] + ".edges" + tail)
+        Path(result).write_text("\n".join(rows) + ("\n" if rows else ""), encoding="utf-8")
+
+    def run_commands(commands, *, max_parallel):
+        events.append(("run", tuple(commands), max_parallel))
+        if mutate_environment:
+            monkeypatch.setenv("PCC_HOST_RECORD_PUBLICATION_DRIFT", "1")
+
+    def read_exports(path, **_kwargs):
+        name = path.removesuffix(".exports")
+        return {name: snapshots[name]}, {}, ()
+
+    def read_edges(path, **_kwargs):
+        name = path.removesuffix(".edges")
+        return (), ((name, ()),) if indexed else ()
+
+    def normal_writer(path, *args, **kwargs):
+        events.append(("legacy", Path(path).name))
+        exports_wire._write_native_exports_wire(path, *args, **kwargs)
+
+    def host_writer(path, *args, **kwargs):
+        events.append(("host", Path(path).name))
+        exports_wire._write_host_native_exports_wire(path, *args, **kwargs)
+
+    monkeypatch.setattr(parallel, "_build_vthread_effect_summaries", lambda *_args, **_kwargs: (["summary.json"], 1))
+    path = parallel.build_shared_exports(
+        str(tmp_path), ["root.py", "dep.py"], modules, [[0], [1]],
+        (sys.executable, "-m", "pcc"),
+        entry_module="root", sibling_inits=(), libpython_mode="off",
+        ir_scaffold_mode="on", verbose=False, max_parallel=2,
+        oversized_chunk_count=1, safe_parallel=2, ast_dir=str(tmp_path / "ast"),
+        module_dependency_map=dependency_map,
+        host_export_contract=contract, host_export_schema=schema,
+        write_host_native_exports_wire=host_writer,
+        build_unique_class_preload_index=lambda values, _tmp: type_infer.build_unique_external_class_preload_index(values),
+        contextual_host_for_module=lambda _name: False,
+        build_contextual_host_export_surface=lambda _exports: {},
+        write_manifest=write_manifest, shell_quote_arg=str, worker_arg="--worker",
+        worker_env_prefix=lambda: contract["worker_environment"],
+        join_strings=lambda values, sep: sep.join(values),
+        run_worker_commands=run_commands, profiled_gc_collect=noop,
+        read_native_exports_wire=read_exports, read_reexport_edges_wire=read_edges,
+        merge_reexport_edges=noop, flatten_class_export_fields=noop,
+        repair_default_global_owners=noop, merge_mixin_stack_methods=noop,
+        merge_codegen_methods=noop, expand_valueclass_export_refs=noop,
+        apply_function_object_uses=noop, read_ast_wire=lambda _path: None,
+        annotate_vthread_effects=noop,
+        annotate_vthread_effect_summaries=lambda *_args: (2, 0, 0),
+        derived_class_map=lambda _exports: {}, write_native_exports_wire=normal_writer,
+        profile_counter=noop, pipeline_error=RuntimeError,
+    )
+    return Path(path), contract, events
+
+
+@pytest.mark.parametrize("case,selected", (
+    ("modern", True), ("legacy", False), ("legacy_timed", False),
+    ("mixed", False), ("unknown", False), ("duplicate", False),
+    ("empty", False), ("environment", False), ("indexed", False),
+))
+def test_shared_publication_requires_all_shards_and_preserves_scheduling(tmp_path, monkeypatch, case, selected):
+    capability = "\t0\t" + exports_wire._HOST_NATIVE_EXPORT_RECORD_SCHEMA
+    rows = [[capability], [capability]]
+    if case == "legacy":
+        rows = [[""], [""]]
+    elif case == "legacy_timed":
+        rows = [["\t13"], ["\t7"]]
+    elif case == "mixed":
+        rows[1] = [""]
+    elif case == "unknown":
+        rows[1] = ["\t0\tunknown"]
+    elif case == "duplicate":
+        rows[1] = [capability, capability]
+    elif case == "empty":
+        rows[1] = []
+    path, contract, events = _publish_mock_shards(
+        tmp_path, monkeypatch, rows,
+        mutate_environment=case == "environment", indexed=case == "indexed",
+    )
+    assert contract["selected"] is selected
+    assert ("legacy", "native_exports_pre_effect.json") in events
+    assert (("host" if selected else "legacy"), "native_exports.json") in events
+    runs = [event for event in events if event[0] == "run"]
+    assert [event[2] for event in runs] == [1, 2]
+    assert [len(event[1]) for event in runs] == [1, 1]
+    for index, event in enumerate(runs):
+        assert event[1][0].startswith(contract["worker_environment"] + " ")
+        assert event[1][0].endswith("export_" + str(index) + ".manifest")
+    assert [event for event in events if event[0] == "manifest"] == [
+        ("manifest", "export", (0,)), ("manifest", "export", (1,)),
+    ]
+    pre_effect = tmp_path / "native_exports_pre_effect.json"
+    assert json.loads(pre_effect.read_text(encoding="utf-8"))["schema"] == exports_wire._NATIVE_EXPORT_WIRE_SCHEMA
+    text = path.read_text(encoding="utf-8")
+    if case == "indexed":
+        assert text.startswith(exports_wire._NATIVE_EXPORT_INDEXED_SCHEMA + "\n")
+    else:
+        assert json.loads(text)["schema"] == (
+            exports_wire._HOST_NATIVE_EXPORT_RECORD_SCHEMA if selected
+            else exports_wire._NATIVE_EXPORT_WIRE_SCHEMA
+        )
+    expected_names = ("root",) if case == "empty" else ("root", "dep")
+    assert tuple(exports_wire._read_native_exports_wire(path)[0]) == expected_names
+
