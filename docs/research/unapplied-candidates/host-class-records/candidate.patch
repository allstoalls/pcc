+@pytest.mark.parametrize("change", ("none", "prefix_list", "after_exports", "during_manifests"))
+def test_codegen_reuses_the_frozen_export_owner_and_rechecks_before_launch(tmp_path, monkeypatch, change):
+    monkeypatch.delenv("PCC_STAGE1_CHECKPOINT_DIR", raising=False)
+    monkeypatch.delenv("PCC_DEFER_FRONTEND_CODEGEN_PLAN", raising=False)
+    sources = []
+    for name in ("root", "dep"):
+        path = tmp_path / (name + ".py")
+        path.write_text("pass\n", encoding="utf-8")
+        sources.append(str(path))
+    prefix = [sys.executable, "-m", "pcc"]
+    environment_calls = []
+    manifests = []
+    launches = []
+    seen = {}
+
+    class StopAtLaunch(Exception):
+        pass
+
+    def worker_environment():
+        environment_calls.append(True)
+        return "PCC_TEST_OWNER=captured" if len(environment_calls) == 1 else "PCC_TEST_OWNER=changed"
+
+    def publish(tmp, _sources, names, _chunks, worker_prefix, **kwargs):
+        contract = kwargs["host_export_contract"]
+        seen["contract"] = contract
+        assert worker_prefix == (sys.executable, "-m", "pcc")
+        assert contract["worker_base"] == worker_prefix + ("--worker",)
+        assert contract["worker_environment"] == "PCC_TEST_OWNER=captured"
+        assert contract["environment"] == dict(os.environ)
+        assert contract["cwd"] == os.getcwd()
+        path = Path(tmp) / "native_exports.json"
+        exports_wire._write_host_native_exports_wire(path, {name: {} for name in names}, {})
+        contract["selected"] = True
+        if change == "prefix_list":
+            prefix[:] = ["pcc1"]
+        if change == "after_exports":
+            monkeypatch.setenv("PCC_HOST_RECORD_LATE_DRIFT", "after-exports")
+        return str(path)
+
+    def write_manifest(_path, _result, _ir, exports_path, _ast, _sources, _names, chunk, **_kwargs):
+        manifests.append(tuple(chunk))
+        assert json.loads(Path(exports_path).read_text(encoding="utf-8"))["schema"] == exports_wire._HOST_NATIVE_EXPORT_RECORD_SCHEMA
+        if change == "during_manifests":
+            monkeypatch.setenv("PCC_HOST_RECORD_LATE_DRIFT", "during-manifests")
+
+    def stop_before_launch(commands, *, max_parallel):
+        launches.append((tuple(commands), max_parallel))
+        raise StopAtLaunch()
+
+    def noop(*_args, **_kwargs):
+        return None
+
+    expected_error = RuntimeError if change in ("after_exports", "during_manifests") else StopAtLaunch
+    with pytest.raises(expected_error) as error:
+        parallel.compile_parallel_uncached(
+            sources, ["root", "dep"], jobs=2, entry_module="root",
+            sibling_inits=(), libpython_mode="off", ir_scaffold_mode="on", verbose=False,
+            can_spawn_worker=lambda: True, worker_command_prefix=lambda: prefix,
+            chunk_count_for_workers=lambda *_args: 2,
+            codegen_chunks=lambda *_args: [[0], [1]], ast_wire_enabled=lambda: False,
+            build_shared_exports_callback=publish, write_manifest=write_manifest,
+            shell_quote_arg=str, worker_arg="--worker", worker_env_prefix=worker_environment,
+            join_strings=lambda values, sep: sep.join(values),
+            run_worker_commands=stop_before_launch, profiled_gc_collect=noop,
+            read_worker_ir=lambda *_args: "", profile_begin=lambda _profile: 0,
+            profile_end=noop, profile_counter=noop, pipeline_error=RuntimeError,
+            auto_source_lanes=False,
+        )
+    assert len(environment_calls) == 1
+    assert seen["contract"]["selected"] is True
+    if change in ("after_exports", "during_manifests"):
+        assert "owner changed" in str(error.value)
+        assert launches == []
+        assert manifests == ([] if change == "after_exports" else [(0,), (1,)])
+    else:
+        assert manifests == [(0,), (1,)]
+        assert len(launches) == 1 and launches[0][1] == 2
+        assert len(launches[0][0]) == 2
+        for command in launches[0][0]:
+            assert command.startswith("PCC_TEST_OWNER=captured " + sys.executable + " -m pcc --worker ")
+
