+from pcc.frontends.python.py_ast import ClassType, FloatType
+from pcc.frontends.python.py_lift import parse_and_lift
+
+
+def _class(name="Shared", owner="owner", *, value=17, bases=()):
+    marker = exports_wire._EXPORT_DEFAULT_WIRE_KEY
+    default = exports_wire._export_default_from_wire({
+        marker: "list",
+        "elems": [
+            {marker: "int", "value": value},
+            {marker: "bytes", "value": [0, 127, 255]},
+        ],
+    })
+    return {
+        "kind": "class",
+        "class_name": name,
+        "owning_module": owner,
+        "base_names": bases,
+        "field_names": ("value",),
+        "field_types": (("value", ("float", 64)),),
+        "methods": ({
+            "name": "measure",
+            "param_types": (("dyn",),),
+            "return_ty": ("float", 64),
+            "call_sig": ({
+                "name": "values",
+                "kind": "pos_or_kw",
+                "annotation": ("dyn",),
+                "has_default": True,
+                "default": default,
+            },),
+        },),
+        "future_metadata": {"labels": ("z", "a"), "enabled": True},
+    }
+
+
+def _fixture_exports():
+    shared = _class()
+    changed_default = _class(value=23)
+    changed_field = deepcopy(shared)
+    changed_field["field_types"] = (("value", ("int", 64, True)),)
+    changed_unknown = deepcopy(shared)
+    changed_unknown["future_metadata"]["labels"] = ("z", "different")
+    changed_method = deepcopy(shared)
+    changed_method["methods"][0]["return_ty"] = ("str",)
+    reordered = dict(reversed(tuple(shared.items())))
+    function = {
+        "kind": "function", "param_types": (), "return_ty": ("dyn",),
+        "call_sig": (), "future_metadata": {"values": (1, 2)},
+    }
+    return {
+        "root": {"Alias": shared, "call": function},
+        "owner": {"Shared": deepcopy(shared), "other_call": function},
+        "variants": {
+            "default": changed_default,
+            "field": changed_field,
+            "unknown": changed_unknown,
+            "method": changed_method,
+            "reordered": reordered,
+        },
+        "empty": {},
+    }
+
+
+def _write_pair(tmp_path, exports=None, derived=None, uses=None):
+    exports = _fixture_exports() if exports is None else exports
+    derived = {"owner.Shared": ("variants.Child",)} if derived is None else derived
+    uses = (("root", "call"), ("owner", "other_call")) if uses is None else uses
+    legacy = tmp_path / "legacy.json"
+    host = tmp_path / "host.json"
+    exports_wire._write_native_exports_wire(legacy, exports, derived, uses)
+    exports_wire._write_host_native_exports_wire(host, exports, derived, uses)
+    return legacy, host
+
+
+def _read(path, mode):
+    if mode == "raw":
+        return exports_wire._read_native_exports_wire_raw_modules(path)
+    if mode == "module":
+        return exports_wire._read_native_exports_wire_for_module(path, "root")
+    include_uses = mode.endswith("with_uses")
+    if mode.startswith("text"):
+        return exports_wire._decode_native_exports_wire(
+            path.read_text(encoding="utf-8"), include_uses,
+        )
+    return exports_wire._read_native_exports_wire(path, include_uses)
+
+
+@pytest.mark.parametrize("mode", (
+    "raw", "full", "full_with_uses", "text", "text_with_uses", "module",
+))
+def test_host_record_readers_are_exactly_legacy_equivalent(tmp_path, mode):
+    legacy, host = _write_pair(tmp_path)
+    assert _read(host, mode) == _read(legacy, mode)
+    if mode == "raw":
+        assert json.dumps(_read(host, mode)) == json.dumps(_read(legacy, mode))
+
+
+def test_records_intern_complete_ordered_raw_class_values_only(tmp_path):
+    exports = _fixture_exports()
+    before = exports_wire._native_export_to_wire(exports)
+    legacy, host = _write_pair(tmp_path, exports)
+    payload = json.loads(host.read_text(encoding="utf-8"))
+    assert tuple(payload) == (
+        "schema", "class_records", "modules", "derived_class_map",
+        "function_object_uses",
+    )
+    assert payload["schema"] == exports_wire._HOST_NATIVE_EXPORT_RECORD_SCHEMA
+    assert len(payload["class_records"]) == 6
+    assert [row[0] for row in payload["modules"]] == list(exports)
+    rows = {name: bindings for name, bindings in payload["modules"]}
+    assert rows["root"][0] == ["Alias", "class", 0]
+    assert rows["owner"][0] == ["Shared", "class", 0]
+    assert rows["root"][1][1] == "inline"
+    assert rows["variants"] == [
+        ["default", "class", 1], ["field", "class", 2],
+        ["unknown", "class", 3], ["method", "class", 4],
+        ["reordered", "class", 5],
