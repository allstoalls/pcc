+def test_late_diagnostic_projection_still_occurs_in_original_order(monkeypatch):
+    monkeypatch.setenv("PCC_SELF_CALLEE_SAVED_REGISTERS", "1")
+    original_facts = regalloc._function_level_facts
+    outcomes = []
+    for filtered in (False, True):
+        with _prepared(_CAST_CALL.format(target=_TARGETS[0])) as (function, kernel):
+            # An actual candidate-definition projection remains late even
+            # when this result's absent slot rules out any interval.
+            frozen_id = kernel.value_id("frozen")
+            kernel.publish_value_slot_id(frozen_id, -1)
+            assert frozen_id in original_facts(kernel)[6]
+            assert frozen_id not in original_facts(kernel, [])[6]
+            events = []
+            original_data = type(kernel).instruction_data
+
+            def data(self, block_id, instruction_index):
+                events.append((block_id, instruction_index))
+                raise ValueError("retained candidate-data diagnostic")
+
+            def facts(current, reload_offsets=None):
+                events.append("facts")
+                return original_facts(current, reload_offsets if filtered else None)
+
+            with monkeypatch.context() as patch:
+                patch.setattr(type(kernel), "instruction_data", data)
+                patch.setattr(regalloc, "_function_level_facts", facts)
+                with pytest.raises(ValueError, match="^retained candidate-data diagnostic$") as caught:
+                    regalloc.allocate_aarch64_block_registers(function)
+            assert type(kernel).instruction_data is original_data
+            outcomes.append((type(caught.value), str(caught.value), events))
+    assert outcomes[0] == outcomes[1]
+    assert outcomes[0][2] == ["facts", (0, 0)]
+
