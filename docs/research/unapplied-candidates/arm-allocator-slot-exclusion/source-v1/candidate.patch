+@pytest.mark.parametrize("bad_edge", [False, True])
+def test_inline_error_edges_remain_in_original_scan_and_first_error(monkeypatch, bad_edge):
+    monkeypatch.setenv("PCC_DIRECT_INDEXED_KERNEL_CAPTURE", "1")
+    monkeypatch.setenv("PCC_DIRECT_INDEXED_KERNEL_EMIT", "1")
+    monkeypatch.setenv("PCC_DIRECT_INDEXED_KERNEL_FUSE_USES", "1")
+    monkeypatch.setattr(ir, "_DIRECT_INLINE_ERROR_EDGE_CAPTURE_ENABLED", True)
+    module = ir.Module(name="slot-exclusion-inline-edge")
+    module.triple = _TARGETS[0]
+    i64 = ir.IntType(64)
+    function = ir.Function(module, ir.FunctionType(i64, [i64]), name="probe")
+    function.args[0].name = "n"
+    entry = function.append_basic_block("entry")
+    error = function.append_basic_block("error")
+    builder = ir.IRBuilder(entry)
+    base = builder.add(function.args[0], ir.Constant(i64, 1), name="base")
+    failed = builder.icmp_signed("!=", base, ir.Constant(i64, 0), name="failed")
+    assert ir.IRBuilder_try_inline_error_edge(builder, failed, error, 42, 0)
+    builder.ret(base)
+    builder.position_at_end(error)
+    result = builder.add(base, function.args[0], name="result")
+    builder.ret(result)
+    prepared = prepare_parsed_module_for_target(
+        module.direct_indexed_module(),
+        aggregate_returned_indirect=aggregate_returned_indirect,
+        aggregate_returned_indirect_indexed=aggregate_returned_indirect_indexed,
+        materialize_legacy_slots=False,
+    )
+    kernel = get_indexed_function_kernel(prepared.functions[0])
+    try:
+        assert len(kernel.error_edge_scalars) == 8
+        base_id = kernel.value_id("base")
+        assert base_id >= 0
+        reloads = [kernel.value_slot_offset(base_id)]
+        assert reloads[0] >= 0
+        calls = []
+        original_target = type(kernel).inline_error_edge_target
+
+        def target(self, edge_id):
+            calls.append(edge_id)
+            if bad_edge:
+                raise IndexError("retained inline-edge diagnostic")
+            return original_target(self, edge_id)
+
+        with monkeypatch.context() as patch:
+            patch.setattr(type(kernel), "inline_error_edge_target", target)
+            if bad_edge:
+                outcomes = []
+                for policy in (None, reloads):
+                    with pytest.raises(IndexError) as caught:
+                        regalloc._function_level_facts(kernel, policy)
+                    outcomes.append((type(caught.value), str(caught.value)))
+                assert outcomes[0] == outcomes[1]
+            else:
+                baseline = regalloc._function_level_facts(kernel)
+                candidate = regalloc._function_level_facts(kernel, reloads)
+                assert base_id in baseline[6] and base_id not in candidate[6]
+                assert candidate[0] == baseline[0]
+                assert candidate[2:6] == baseline[2:6]
+                assert candidate[1].keys() == baseline[1].keys()
+                for value_id in baseline[1]:
+                    if kernel.value_slot_offset(value_id) not in reloads:
+                        assert candidate[1][value_id] == baseline[1][value_id]
+                        assert candidate[6].get(value_id) == baseline[6].get(value_id)
+        assert calls == [0, 0]
+    finally:
+        for parsed_function in prepared.functions:
+            get_indexed_function_kernel(parsed_function).close_native_tables()
