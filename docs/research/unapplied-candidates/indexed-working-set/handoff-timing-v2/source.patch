+            "scope_complete=" + str(int(complete)),
+            "clock_ok=" + str(int(clock_ok)),
+            "pool_elapsed_ns=" + str(elapsed_ns if elapsed_ns >= 0 else 0)[:32],
+            "prepare_ns=" + str(totals_ns[0])[:32],
+            "reset_ns=" + str(totals_ns[1])[:32],
+            "retire_ns=" + str(totals_ns[2])[:32],
+            "prepare_calls=" + str(counts[0])[:32],
+            "reset_calls=" + str(counts[1])[:32],
+            "retire_calls=" + str(counts[2])[:32],
+            "blocking_ns=" + str(blocking_ns)[:32],
