+@pytest.mark.parametrize("failure", ("exception", "backwards", "zero"))
+def test_end_clock_failure_reports_unavailable(monkeypatch, failure):
+    def clock():
+        if failure == "exception":
+            raise RuntimeError("clock unavailable")
+        return 0 if failure == "zero" else 99
+
+    monkeypatch.setattr(timing.time, "perf_counter_ns", clock)
+    stream = io.StringIO()
+    assert timing.handoff_timing_report(stream, "sample", "scope", 100, True) == -1
+    assert "elapsed_ns=0 scope_complete=1 clock_ok=0\n" in stream.getvalue()
+
+
+def test_stream_failure_preserves_elapsed_scalar_without_retry(monkeypatch):
+    calls = []
+
+    class BrokenStream:
+        def write(self, text):
+            calls.append(text)
