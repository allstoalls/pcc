+@pytest.mark.parametrize("clock_failure", (False, True))
+def test_diagnostics_in_finally_preserve_same_original_error(monkeypatch, clock_failure):
+    original = ValueError("original compilation error")
+
+    def clock():
+        if clock_failure:
+            raise RuntimeError("clock unavailable")
