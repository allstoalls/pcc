+from pcc.backend import indexed_phase_timing as timing
+
+
+def test_disabled_start_does_not_read_clock(monkeypatch):
+    calls = []
+
+    def forbidden_clock():
+        calls.append(1)
+        raise AssertionError("disabled timing read the clock")
+
+    monkeypatch.setattr(timing.time, "perf_counter_ns", forbidden_clock)
+    assert timing.handoff_timing_start(False) == 0
+    assert calls == []
+
+
+@pytest.mark.parametrize("tick, expected", ((100, 100), (0, 0), (-1, 0)))
+def test_start_accepts_only_positive_clock_tokens(monkeypatch, tick, expected):
+    calls = []
+
+    def clock():
+        calls.append(1)
+        return tick
+
+    monkeypatch.setattr(timing.time, "perf_counter_ns", clock)
+    assert timing.handoff_timing_start(True) == expected
+    assert len(calls) == 1
+
+
+def test_start_clock_exception_is_best_effort(monkeypatch):
+    def broken_clock():
+        raise RuntimeError("clock unavailable")
+
+    monkeypatch.setattr(timing.time, "perf_counter_ns", broken_clock)
+    assert timing.handoff_timing_start(True) == 0
+
+
+@pytest.mark.parametrize("complete", (False, True))
+@pytest.mark.parametrize("end, elapsed", ((100, 0), (137, 37)))
+def test_report_exact_scalar_fields(monkeypatch, complete, end, elapsed):
+    monkeypatch.setattr(timing.time, "perf_counter_ns", lambda: end)
+    stream = io.StringIO()
+    assert timing.handoff_timing_report(
+        stream, "sample", "pool_communicate", 100, complete, 7, 123,
+    ) == elapsed
+    assert stream.getvalue() == (
+        "pcc indexed handoff timing module='sample' scope=pool_communicate "
+        "task=7 pid=123 elapsed_ns=" + str(elapsed)
+        + " scope_complete=" + str(int(complete)) + " clock_ok=1\n"
+    )
+
+
+@pytest.mark.parametrize("started", (0, -1))
+def test_invalid_start_reports_unavailable_without_reading_clock(monkeypatch, started):
