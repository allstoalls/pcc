+    scope: str,
+    started_ns: int,
+    complete: bool,
+    task_index: int = -1,
+    worker_pid: int = 0,
+) -> int:
+    """Emit one best-effort line; return elapsed nanoseconds or -1 on bad clock."""
+    elapsed_ns = -1
+    try:
+        if started_ns > 0:
+            measured_ns = time.perf_counter_ns() - started_ns
+            if measured_ns >= 0:
+                elapsed_ns = measured_ns
+    except Exception:
+        pass
+    try:
+        # Bound identifiers before escaping, and numeric renderings afterward.
+        # Even pathological labels fit a single line of at most 2048 characters.
+        parts = [
+            "pcc indexed handoff timing",
+            "module=" + repr(module_name[:96]),
+            "scope=" + repr(scope[:64])[1:-1],
+            "task=" + str(task_index)[:32],
+            "pid=" + str(worker_pid)[:32],
+            "elapsed_ns=" + str(elapsed_ns if elapsed_ns >= 0 else 0)[:32],
+            "scope_complete=" + str(int(complete)),
+            "clock_ok=" + str(int(elapsed_ns >= 0)),
+        ]
+        stream.write(" ".join(parts) + "\n")
+    except Exception:
+        # Preserve the measured scalar even when the diagnostic sink fails.
+        pass
+    return elapsed_ns
+
+
+def handoff_pool_report(
+    stream,
+    started_ns: int,
+    totals_ns,
+    counts,
+    clock_ok: bool,
+    complete: bool,
+    terminal: bool,
+    owner_pid: int,
+) -> bool:
+    """Report three cumulative blocking totals against the current pool wall."""
+    elapsed_ns = -1
+    try:
+        if started_ns > 0:
+            measured_ns = time.perf_counter_ns() - started_ns
+            if measured_ns >= 0:
+                elapsed_ns = measured_ns
+    except Exception:
+        pass
+    clock_ok = clock_ok and elapsed_ns >= 0
