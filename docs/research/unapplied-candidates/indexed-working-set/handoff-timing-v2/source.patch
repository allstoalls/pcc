+def handoff_timing_start(enabled: bool) -> int:
+    """Return a positive clock token, or zero without affecting the caller."""
+    if not enabled:
+        return 0
+    try:
+        started_ns = time.perf_counter_ns()
+        if started_ns > 0:
+            return started_ns
+    except Exception:
+        pass
+    return 0
+
