+            assert any(original in ast.walk(body) for body in boundary.body)
+            assert not any(
+                isinstance(node, ast.If) and enabled_guard(node.test)
+                for node in ancestors(original)
+            )
+    starts = [call for call in calls if call.func.id == "handoff_timing_start"]
+    assert len(starts) == len(expected) + int(relative.endswith("worker_process_pool.py"))
+    for start in starts:
+        guard = parents[start]
+        assert isinstance(guard, ast.IfExp) and guard.body is start
+        assert enabled_guard(guard.test)
+        assert isinstance(guard.orelse, ast.Constant) and guard.orelse.value == 0
+
+
+def test_pool_snapshots_are_operation_bound_and_terminal_after_cleanup():
+    root = Path(__file__).resolve().parents[2]
+    source = (root / "pcc/frontends/python/worker_process_pool.py").read_text()
+    tree = ast.parse(source)
+    parents = {child: node for node in ast.walk(tree) for child in ast.iter_child_nodes(node)}
+    summaries = [node for node in ast.walk(tree) if isinstance(node, ast.Call)
+                 and isinstance(node.func, ast.Name) and node.func.id == "handoff_pool_report"]
+    assert len(summaries) == 4
+    progress = [call for call in summaries if call.args[6].value is False]
+    terminal = [call for call in summaries if call.args[6].value is True]
+    assert len(progress) == 3 and len(terminal) == 1
+    for call in summaries:
+        assert [arg.id for arg in call.args[1:5]] == [
+            "handoff_pool_started", "handoff_totals", "handoff_counts", "handoff_clock_ok",
+        ]
+        assert any(
+            isinstance(node, ast.If) and isinstance(node.test, ast.Name)
+            and node.test.id == "handoff_timing_enabled" and call in ast.walk(node)
+            for node in ast.walk(tree)
+        )
+    for call in progress:
+        assignment = parents[call]
+        assert isinstance(assignment, ast.Assign)
+        assert assignment.targets[0].id == "handoff_clock_ok"
+        boundary = assignment
+        while not isinstance(boundary, ast.Try):
+            boundary = parents[boundary]
+        assert call in ast.walk(boundary.body[-1])
+        assert any(
+            isinstance(child, ast.Call) and isinstance(child.func, ast.Name)
+            and child.func.id == "handoff_timing_report" for child in ast.walk(boundary)
+        )
+    assert 'handoff_totals = [0, 0, 0] if handoff_timing_enabled else []' in source
+    assert 'handoff_counts = [0, 0, 0] if handoff_timing_enabled else []' in source
+    assert '_stop_resource_worker(pid)' in source[:source.index(ast.get_source_segment(source, terminal[0]))]
+    assert '"pool_loop_inclusive"' not in source
+
+
+@pytest.mark.parametrize("enabled", (False, True))
+@pytest.mark.parametrize("cleanup_error", (False, True))
+def test_mock_pool_timing_preserves_lifecycle_and_error_identity(
+    tmp_path, monkeypatch, enabled, cleanup_error,
+):
+    from tests.python.test_host_indexed_process_split import (
+        MIB, _mock_lifecycle, _run_mock_pool, handoff, pool,
+    )
+
+    tasks, events, tokens, sidecar = _mock_lifecycle(
+        tmp_path, monkeypatch, cleanup_error=cleanup_error,
+    )
+    monkeypatch.setenv("PCC_PY_FRONTEND_WORKER_TIMING", "1" if enabled else "0")
+    clock_calls, original_errors = [], []
+    cleanup = handoff.retire_handoff_task
+
+    def clock():
+        clock_calls.append(1)
+        return 100 + 10 * len(clock_calls)
+
+    def observed_cleanup(task, token):
+        try:
+            return cleanup(task, token)
+        except OSError as error:
+            original_errors.append(error)
+            raise
+
+    monkeypatch.setattr(timing.time, "perf_counter_ns", clock)
+    monkeypatch.setattr(handoff, "retire_handoff_task", observed_cleanup)
+    stream = io.StringIO()
+    monkeypatch.setattr(pool.sys, "stderr", stream)
+    observations = []
+    if cleanup_error:
+        with pytest.raises(OSError, match="mock cleanup blocked") as caught:
+            _run_mock_pool(tasks, observations)
+        assert caught.value is original_errors[0]
+        assert sidecar.read_bytes() == b"sealed input"
+    else:
+        _run_mock_pool(tasks, observations)
+        assert not sidecar.exists() and not original_errors
+    lifecycle = [event for event in events if event[0] in ("start", "prepare", "reset", "cleanup")]
+    assert lifecycle == [
+        ("start", 0), ("prepare", tokens[0]), ("reset", 1),
+        ("start", 1), ("cleanup", tokens[1]),
+    ] + ([] if cleanup_error else [("start", 2)])
+    assert [sample[0] for sample in observations] == (
+        ["frontend"] if cleanup_error else ["frontend", "backend", "frontend"]
+    )
+    assert all(sample[2] == MIB for sample in observations)
+    assert len(clock_calls) == (11 if enabled else 0)
+    lines = [line for line in stream.getvalue().splitlines()
+             if line.startswith("pcc indexed handoff ")]
+    if not enabled:
+        assert lines == []
+        return
+    operations = [line for line in lines if line.startswith("pcc indexed handoff timing ")]
+    assert len(operations) == 3
+    assert [line.split(" scope=", 1)[1].split()[0] for line in operations] == [
+        "pool_prepare", "pool_reset", "pool_retire",
+    ]
+    assert sum("snapshot=progress" in line for line in lines) == 3
+    assert sum("snapshot=terminal" in line for line in lines) == 1
+    complete = "scope_complete=" + str(int(not cleanup_error))
+    assert complete in operations[-1] and complete in lines[-1]
+    assert "snapshot=terminal" in lines[-1]
+    assert all("clock_ok=1" in line for line in lines)
