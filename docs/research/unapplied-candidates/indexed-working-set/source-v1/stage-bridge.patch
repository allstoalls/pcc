+    # filename on retry so pressure cancellation cannot accumulate PIDX files.
+    temporary = sidecar + ".tmp"
+    _path(temporary, "producer temporary path")
+    if os.path.lexists(temporary):
+        _regular(temporary)
+        os.unlink(temporary)
